FROM docker.io/library/python:3.12-slim

ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/jonasbjork/the-wall" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}"

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt && pip freeze > /app/requirements.lock.txt

COPY app.py start.sh ./
# OpenShift runs the container with a random UID in group 0 -> group needs access

RUN chgrp -R 0 /app && chmod -R g=u /app

USER 1001
EXPOSE 8080
CMD ["/app/start.sh"]
